# 複製成 scripts/dev.env 後修改（dev.env 不進版控）。scripts/dev.sh 啟動時會讀取。
# 這裡只放「這台機器」的路徑與埠號；資料路徑仍以 config/settings.yaml 為準。

# 專案 venv 的 python（裡面要有 uvicorn）
PYTHON=/path/to/venvs/coloring-books/bin/python

# 埠號
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 選填：區網其他電腦開開發伺服器時用的額外主機名稱／IP（逗號分隔）。
# 本機主機名稱、完整網域名稱、區網 IP 會自動加入，通常不用設。
# DEV_ALLOWED_ORIGINS=my-alias,10.0.0.5

# ComfyUI 位址預設讀 config/settings.yaml 的 comfy.url（http://127.0.0.1:8188）。
# 只有要連到別的埠時才覆寫，例如 8188 被別的服務占用：
# APP_COMFY__URL=http://127.0.0.1:8190

# 選填：dev.sh --comfy 時用來啟動 ComfyUI 的指令（只綁本機；埠號要和上面的 ComfyUI 位址一致）。
# ComfyUI 已經在那個位址執行時，dev.sh 會略過啟動。
# COMFY_START_CMD="source ~/tools/comfy-cli-venv/bin/activate && comfy --workspace ~/projects/comfyui launch -- --listen 127.0.0.1 --port 8188 --disable-auto-launch"
