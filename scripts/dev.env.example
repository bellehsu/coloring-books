# 複製成 scripts/dev.env 後修改（dev.env 不進版控）。scripts/dev.sh 啟動時會讀取。
# 這裡只放「這台機器」的路徑與埠號；資料路徑仍以 config/settings.yaml 為準。

# 專案 venv 的 python（裡面要有 uvicorn）
PYTHON=/path/to/venvs/coloring-books/bin/python

# 埠號
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 選填：覆寫 settings.yaml 的 ComfyUI 位址（例如 8188 被別的服務占用時）
# APP_COMFY__URL=http://127.0.0.1:8190

# 選填：dev.sh --comfy 時用來啟動 ComfyUI 的指令（只綁本機）
# COMFY_START_CMD="source ~/tools/comfy-cli-venv/bin/activate && comfy --workspace ~/projects/comfyui launch -- --listen 127.0.0.1 --port 8190 --disable-auto-launch"
