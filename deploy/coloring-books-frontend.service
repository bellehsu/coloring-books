# systemd user service：前端（Next.js standalone）
# 必改：WorkingDirectory 的專案路徑；node 若不在 /usr/bin/node（例如用 nvm），改 ExecStart。
# 前提：已在 frontend/ 以 BACKEND_URL 執行 npm run build，並複製 .next/static（見 docs/deploy-intranet.md）。
[Unit]
Description=Coloring Books frontend (Next.js standalone)
After=network.target coloring-books-backend.service

[Service]
Type=simple
WorkingDirectory=/ai-data/repos/coloring-books/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
